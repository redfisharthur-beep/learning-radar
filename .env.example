NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: canonical application URL used for Supabase email confirmation redirects.
# Production value: https://learning-radar-wheat.vercel.app
# Local development can leave this unset to use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Server-side only. Add a real key to Vercel Production environment variables.
OPENAI_API_KEY=
# Optional model override; default is gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
